rules_version = '2';

// Haven: Firestore security rules (data layout v2).
//
// Who can do what is decided here, on the server, not in the app:
//   * Nothing is readable or writable without Firebase Authentication.
//   * A family's data is visible only to accounts that have a member record in that family.
//   * A member is a "parent" or a "child". The role is written by a parent when a device is
//     enrolled and can never be changed afterwards.
//   * A device joins with a one-time pairing code that a parent creates. The device claims the
//     code, a parent approves the claim, and only then does the device become a member.
//   * A child device can read its own child's records and the family rules that apply to it. It
//     can ask for time, check in, raise or clear its own SOS, send chat messages as itself and
//     tick tasks. It cannot change limits, rules, membership or anyone else's records.
//
// Layout
//   users/{uid}                                  which family this account belongs to
//   pairing/{code}                               one-time pairing codes
//   families/{fid}                               the family
//   families/{fid}/members/{uid}                 one record per enrolled account (role lives here)
//   families/{fid}/devices/{deviceId}            "last seen" per installed app
//   families/{fid}/children/{cid}                a child's profile, limits and app rules (parent-owned)
//   families/{fid}/children/{cid}/live/status    what the child's device reports (check-in time)
//   families/{fid}/children/{cid}/requests/{id}  requests from that child
//   families/{fid}/children/{cid}/messages/{id}  chat between the parents and that child
//   families/{fid}/alerts/{id}                   the parents' activity feed
//   families/{fid}/places|schedules|sites|tasks/{id}   family rules (parent-owned)
//   families/{fid}/signals/sos                   the SOS flag
//
// See docs/SECURITY.md for the reasoning and how to publish this file. Every rule below is
// covered by the tests in tests/rules (npm run test:rules): change a rule and its tests together.

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------------------------
    // EDIT BEFORE PUBLISHING: the email addresses that may create a family in this project.
    // Everyone else can only join by pairing code.
    // Write them in lower case: Firebase Auth lower-cases the address of an account, and the
    // comparison here is exact. Keep the form  return ['a@b.c', 'd@e.f'];  on one line: the tests
    // (tests/rules) put their own test address in its place, so editing the list does not break
    // them, and one of them checks that every entry is lower case.
    // ------------------------------------------------------------------------------------------
    function ownerEmails() {
      return ['dispatch.johnsmith@gmail.com'];
    }

    // ---- Identity ----------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Signed in with email and password: the only way a parent signs in to Haven.
    // Red team: this used to read "not anonymous". A token from any other sign-in method that
    // carries email_verified (a custom token, or a provider switched on in the console later
    // that reports an address it has not checked) then counted as a confirmed parent account,
    // and with an address from ownerEmails() it could create a family. Naming the one method
    // that is meant keeps that shut. A token without the claim is refused (an error refuses).
    function usesPassword() {
      return request.auth.token.firebase.sign_in_provider == 'password';
    }

    // A real account whose email address has been confirmed.
    function hasVerifiedEmail() {
      return signedIn() && usesPassword() && request.auth.token.email_verified == true;
    }

    function mayCreateFamily() {
      return hasVerifiedEmail() && request.auth.token.email in ownerEmails();
    }

    // ---- Membership --------------------------------------------------------------------------

    function familyPath(fid) {
      return /databases/$(database)/documents/families/$(fid);
    }

    function memberPath(fid, uid) {
      return /databases/$(database)/documents/families/$(fid)/members/$(uid);
    }

    function isMember(fid) {
      return signedIn() && exists(memberPath(fid, request.auth.uid))
        && (myRecord(fid).role == 'parent' || childExists(fid, myRecord(fid).childId));
    }

    // The caller's own member record. For an account that is not in the family there is no such
    // record: reading it is an error, and a rule that hits an error refuses. So isParent and
    // isChild below fail closed for outsiders without a separate exists() call. That keeps every
    // request at one lookup of the member record (Firestore allows 10 lookups per write and 20
    // per batch; see tests/rules/07-access-call-budget.test.mjs).
    function myRecord(fid) {
      return get(memberPath(fid, request.auth.uid)).data;
    }

    function isParent(fid) {
      return signedIn() && myRecord(fid).role == 'parent';
    }

    function isChild(fid) {
      return signedIn() && myRecord(fid).role == 'child' && childExists(fid, myRecord(fid).childId);
    }

    // The device enrolled as this particular child.
    function isChildOf(fid, cid) {
      return isChild(fid) && myRecord(fid).childId == cid;
    }

    function profilePath(fid, cid) {
      return /databases/$(database)/documents/families/$(fid)/children/$(cid);
    }

    function childExists(fid, cid) {
      return get(profilePath(fid, cid)).data.get('retired', false) == false;
    }

    function retired(fid, cid) {
      return get(profilePath(fid, cid)).data.get('retired', false) == true;
    }

    function retiredMember(fid, uid) {
      let member = get(memberPath(fid, uid)).data;
      return member.role == 'child' && retired(fid, member.childId);
    }

    // ---- Small helpers -----------------------------------------------------------------------

    function idOk(id) {
      return id.matches('^[A-Za-z0-9_-]{1,40}$');
    }

    function text(value, max) {
      return value is string && value.size() <= max;
    }

    function nonEmptyText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function platformOk(value) {
      return value in ['android', 'ios', 'web'];
    }

    // Only these fields differ between the stored document and the incoming one.
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---- users/{uid}: which family an account belongs to --------------------------------------
    // Written by the account itself, and only ever pointing at a family that lists it as a member
    // with that role (now, or once the same batch has been applied).

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['familyId', 'role', 'updatedAt'])
        && request.resource.data.keys().hasAll(['familyId', 'role', 'updatedAt'])
        && request.resource.data.familyId is string && idOk(request.resource.data.familyId)
        && request.resource.data.updatedAt == request.time
        && existsAfter(memberPath(request.resource.data.familyId, uid))
        && getAfter(memberPath(request.resource.data.familyId, uid)).data.role == request.resource.data.role
        // Red team: the pointer may move to another family only once the account has left the
        // family it names (at the latest in this same batch). Without this, a founder who was
        // also enrolled in a second family could point there, leave it, delete the pointer and
        // create another family: "one family per account" rests on the founder's pointer
        // staying where it is, since the founder can never leave.
        && (resource == null
              || resource.data.familyId == request.resource.data.familyId
              || !existsAfter(memberPath(resource.data.familyId, uid)));

      allow delete: if resource.data.role == 'child' && isParent(resource.data.familyId)
        && retiredMember(resource.data.familyId, uid)
        && !existsAfter(memberPath(resource.data.familyId, uid));

      // The pointer can be removed only once the account is no longer in that family.
      allow delete: if signedIn() && request.auth.uid == uid
        && !existsAfter(memberPath(resource.data.familyId, uid));
    }

    // ---- pairing/{code}: one-time pairing codes -------------------------------------------------
    // create : a parent of the family, for at most 15 minutes
    // claim  : any signed-in device that knows the code, once, before it expires
    // approve: a parent of the family, in the same batch that creates the member record
    // Codes cannot be listed, and can be read only by the family's parents and by the device that
    // claimed them. A wrong guess reveals nothing: the claim is simply refused.
    //
    // How long a code lasts is measured on the server's clock: 15 minutes from createdAt, which is
    // always the server's time. expiresAt is written by the parent's phone (the app shows a
    // countdown to it). A phone clock is rarely exact, so expiresAt may sit up to 5 minutes later
    // than the server's "15 minutes from now" when the code is made. It can end a code early but
    // never keep it alive: a code stops working 15 minutes after the server stored it, whatever
    // expiresAt says.

    function codeOpen(pairing) {
      return request.time < pairing.createdAt + duration.value(15, 'm')
        && request.time < pairing.expiresAt;
    }

    // A claim that came in just before the end can still be approved for 15 more minutes.
    function codeApprovable(pairing) {
      return request.time < pairing.createdAt + duration.value(30, 'm')
        && request.time < pairing.expiresAt + duration.value(15, 'm');
    }

    match /pairing/{code} {
      allow get: if signedIn()
        && (resource.data.claimedBy == request.auth.uid || isParent(resource.data.familyId));
      allow list: if false;

      allow create: if code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$')
        && request.resource.data.keys().hasOnly(
             ['familyId', 'role', 'createdBy', 'createdAt', 'expiresAt', 'claimedBy', 'claimName', 'claimPlatform', 'claimedAt', 'approved'])
        && request.resource.data.keys().hasAll(
             ['familyId', 'role', 'createdBy', 'createdAt', 'expiresAt', 'claimedBy', 'claimName', 'claimPlatform', 'claimedAt', 'approved'])
        && request.resource.data.familyId is string
        && isParent(request.resource.data.familyId)
        && request.resource.data.role in ['child', 'parent']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // 15 minutes, plus 5 for a phone whose clock runs fast (see codeOpen above)
        && request.resource.data.expiresAt <= request.time + duration.value(20, 'm')
        && request.resource.data.claimedBy == null
        && request.resource.data.claimName == null
        && request.resource.data.claimPlatform == null
        && request.resource.data.claimedAt == null
        && request.resource.data.approved == false;

      // Claim. The first check fails for a code that does not exist, so guessing learns nothing.
      allow update: if signedIn()
        && resource.data.claimedBy == null
        && resource.data.approved == false
        && codeOpen(resource.data)
        && onlyChanged(['claimedBy', 'claimName', 'claimPlatform', 'claimedAt'])
        && request.resource.data.claimedBy == request.auth.uid
        && nonEmptyText(request.resource.data.claimName, 40)
        && platformOk(request.resource.data.claimPlatform)
        && request.resource.data.claimedAt == request.time
        && !exists(memberPath(resource.data.familyId, request.auth.uid))
        // A code for another parent needs a real, confirmed account. A child device signs in anonymously.
        && (resource.data.role == 'child' || hasVerifiedEmail());

      // Approve. Uses the code up, and is only valid together with the matching member record.
      allow update: if isParent(resource.data.familyId)
        && resource.data.claimedBy != null
        && resource.data.approved == false
        && codeApprovable(resource.data)
        && onlyChanged(['approved'])
        && request.resource.data.approved == true
        && existsAfter(memberPath(resource.data.familyId, resource.data.claimedBy))
        && getAfter(memberPath(resource.data.familyId, resource.data.claimedBy)).data.code == code;

      // Withdraw or decline a code, or tidy it away after use.
      allow delete: if signedIn()
        && (resource.data.claimedBy == request.auth.uid || isParent(resource.data.familyId));
    }

    // ---- families/{fid} -----------------------------------------------------------------------

    match /families/{fid} {
      allow get: if isMember(fid);
      allow list: if false;

      // Created by an allowed, verified account, together with its own member record and its
      // users/{uid} pointer. One family per account.
      allow create: if mayCreateFamily()
        && idOk(fid)
        && request.resource.data.keys().hasOnly(['v', 'owner', 'name', 'createdAt'])
        && request.resource.data.keys().hasAll(['v', 'owner', 'name', 'createdAt'])
        && request.resource.data.v == 2
        && request.resource.data.owner == request.auth.uid
        && nonEmptyText(request.resource.data.name, 60)
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == fid
        && getAfter(memberPath(fid, request.auth.uid)).data.role == 'parent';

      allow update: if isParent(fid)
        && onlyChanged(['name'])
        && nonEmptyText(request.resource.data.name, 60);

      allow delete: if false;

      // ---- members/{uid}: who is in the family, and as what ---------------------------------

      function memberShapeOk(data) {
        return data.keys().hasOnly(['role', 'childId', 'name', 'platform', 'joinedAt', 'addedBy', 'code'])
          && data.keys().hasAll(['role', 'childId', 'name', 'platform', 'joinedAt', 'addedBy', 'code'])
          && data.role in ['parent', 'child']
          && nonEmptyText(data.name, 40)
          && platformOk(data.platform);
      }

      // The pairing code that enrols `uid` with this member record: claimed by that very account,
      // for this family and this role, not used before, and used up by this same batch.
      function enrolmentOk(uid, data) {
        let codePath = /databases/$(database)/documents/pairing/$(data.code);
        let pairing = get(codePath).data;
        return data.code is string
          && pairing.familyId == fid
          && pairing.claimedBy == uid
          && pairing.role == data.role
          && pairing.claimName == data.name
          && pairing.claimPlatform == data.platform
          && pairing.approved == false
          && codeApprovable(pairing)
          && getAfter(codePath).data.approved == true;
      }

      match /members/{uid} {
        allow read: if isMember(fid);

        // The founder's own record, in the batch that creates the family.
        allow create: if signedIn() && request.auth.uid == uid
          && !exists(familyPath(fid))
          && getAfter(familyPath(fid)).data.owner == uid
          && memberShapeOk(request.resource.data)
          && request.resource.data.role == 'parent'
          && request.resource.data.childId == null
          && request.resource.data.code == null
          && request.resource.data.addedBy == uid
          && request.resource.data.joinedAt == request.time;

        // Enrolment: a parent approves the device that claimed a pairing code.
        allow create: if isParent(fid)
          && request.auth.uid != uid
          && memberShapeOk(request.resource.data)
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.joinedAt == request.time
          && enrolmentOk(uid, request.resource.data)
          && (request.resource.data.role == 'parent'
                ? request.resource.data.childId == null
                : (request.resource.data.childId is string
                    && getAfter(profilePath(fid, request.resource.data.childId)).data.get('retired', false) == false));

        // A parent may relabel a member or point a child device at another child profile.
        // The role, and how the member got in, never change.
        allow update: if isParent(fid)
          && (resource.data.role == 'parent' || childExists(fid, resource.data.childId))
          && onlyChanged(['name', 'childId'])
          && nonEmptyText(request.resource.data.name, 40)
          && (resource.data.role == 'parent'
                ? request.resource.data.childId == null
                : (request.resource.data.childId is string && childExists(fid, request.resource.data.childId)));

        // A parent removes a device, or a device leaves by itself. The founder always stays.
        // Only a member can do either, so an outsider cannot use this to find out whether a
        // family id exists.
        allow delete: if isMember(fid)
          && uid != get(familyPath(fid)).data.owner
          && (request.auth.uid == uid || isParent(fid));
      }

      // ---- devices/{deviceId}: "last seen" per installed app --------------------------------

      match /devices/{deviceId} {
        allow read: if isMember(fid);

        allow create, update: if isMember(fid)
          && idOk(deviceId)
          && (resource == null || resource.data.uid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'platform', 'lastSeenAt'])
          && request.resource.data.keys().hasAll(['uid', 'name', 'platform', 'lastSeenAt'])
          && request.resource.data.uid == request.auth.uid
          && nonEmptyText(request.resource.data.name, 40)
          && platformOk(request.resource.data.platform)
          && request.resource.data.lastSeenAt == request.time;

        allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isParent(fid);
      }

      // ---- children/{cid}: profile, limits and app rules. Parent-owned. ----------------------

      function childShapeOk(data) {
        return data.keys().hasOnly(
                 ['name', 'age', 'deviceName', 'battery', 'online', 'bedtime', 'usedMin', 'limitMin', 'place', 'placeIcon', 'apps', 'weekly', 'ord'])
          && data.keys().hasAll(
                 ['name', 'age', 'deviceName', 'battery', 'online', 'bedtime', 'usedMin', 'limitMin', 'place', 'placeIcon', 'apps', 'weekly', 'ord'])
          && nonEmptyText(data.name, 60)
          && data.age is number && data.age >= 0 && data.age <= 25
          && text(data.deviceName, 60)
          && data.battery is number && data.battery >= 0 && data.battery <= 100
          && data.online is bool
          && data.bedtime is bool
          && data.usedMin is number && data.usedMin >= 0 && data.usedMin <= 1440
          && data.limitMin is number && data.limitMin >= 0 && data.limitMin <= 1440
          && text(data.place, 60)
          && text(data.placeIcon, 40)
          && data.apps is list && data.apps.size() <= 60
          && data.weekly is list && data.weekly.size() == 7
          && data.ord is number;
      }

      match /children/{cid} {
        function pinPath() {
          return /databases/$(database)/documents/families/$(fid)/children/$(cid)/unlock/pin;
        }
        function attemptPath() {
          return /databases/$(database)/documents/families/$(fid)/children/$(cid)/unlock/attempt;
        }
        function redeemable() {
          let pin = get(pinPath()).data;
          let attempt = get(attemptPath()).data;
          return attempt.by == request.auth.uid && attempt.code == pin.code
            && attempt.at >= pin.at && pin.at + duration.value(10, 'm') > request.time
            && attempt.at + duration.value(1, 'm') > request.time;
        }
        match /unlock/pin {
          allow create, update: if isParent(fid) && childExists(fid, cid) && request.resource.data.keys().hasOnly(['code', 'at'])
            && request.resource.data.code.matches('^[0-9]{5}$') && request.resource.data.at == request.time;
          allow delete: if isParent(fid) || (isChildOf(fid, cid) && redeemable() && !existsAfter(attemptPath()));
        }
        match /unlock/attempt {
          function validAttempt() {
            return isChildOf(fid, cid) && request.resource.data.keys().hasOnly(['code', 'at', 'by'])
              && request.resource.data.code.matches('^[0-9]{5}$') && request.resource.data.by == request.auth.uid
              && request.resource.data.at == request.time;
          }
          allow create: if validAttempt();
          allow update: if validAttempt() && resource.data.at + duration.value(1, 'm') <= request.time;
          allow delete: if isChildOf(fid, cid) && redeemable() && !existsAfter(pinPath());
        }
        allow get: if isParent(fid) || isChildOf(fid, cid);
        allow list: if isParent(fid);
        allow create: if isParent(fid) && idOk(cid) && childShapeOk(request.resource.data);
        allow update: if isParent(fid) && resource.data.get('retired', false) == false
          && (childShapeOk(request.resource.data) || request.resource.data == {'retired': true, 'pending': true});
        allow update: if isParent(fid) && resource.data.get('retired', false) == true
          && request.resource.data == {'retired': true, 'pending': false};
        allow update: if isChildOf(fid, cid) && resource.data.bedtime == true
          && request.resource.data.bedtime == false && onlyChanged(['bedtime'])
          && redeemable() && !existsAfter(pinPath()) && !existsAfter(attemptPath());
        allow delete: if false;

        match /{group}/{entry} {
          allow list, delete: if group in ['live', 'settings', 'packageRules', 'unlock', 'photos',
              'location', 'checkins', 'management', 'usage', 'requests', 'messages', 'voice', 'tripPoints']
            && isParent(fid) && retired(fid, cid);
        }

        // What the child's own device reports. Today: the time of its last check-in.
        match /live/{docId} {
          allow read: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if docId == 'status'
            && isChildOf(fid, cid)
            && request.resource.data.keys().hasOnly(['checkInAt', 'by'])
            && request.resource.data.keys().hasAll(['checkInAt', 'by'])
            && request.resource.data.checkInAt == request.time
            && request.resource.data.by == request.auth.uid;
          allow delete: if false;
        }

        // Explicit, permissioned location reports from the enrolled child device.
        // A report contains no background tracking history and cannot be written by a parent.
        match /packageRules/{pkg} {
          allow read: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isParent(fid) && childExists(fid, cid) && pkg.size() <= 255
            && pkg.matches('[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+')
            && request.resource.data.keys().hasOnly(['minutes', 'blocked'])
            && request.resource.data.minutes is int && request.resource.data.minutes >= 0
            && request.resource.data.minutes <= 1440 && request.resource.data.blocked is bool;
          allow delete: if isParent(fid);
        }
        match /settings/offline {
          allow get: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isParent(fid) && childExists(fid, cid) && request.resource.data.keys().hasOnly(['enabled'])
            && request.resource.data.enabled is bool;
          allow delete: if isParent(fid);
        }
        match /photos/avatar {
          allow get: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isParent(fid) && childExists(fid, cid)
            && request.resource.data.keys().hasOnly(['jpeg']) && boundedJpeg(request.resource.data.jpeg);
          allow delete: if isParent(fid);
        }
        function boundedJpeg(jpeg) {
          return jpeg is string && jpeg.size() <= 240000 && jpeg.matches('/9j/[A-Za-z0-9+/=]+');
        }
        match /photos/screen {
          allow get: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isChildOf(fid, cid) && request.resource.data.keys().hasOnly(['jpeg', 'by', 'at'])
            && boundedJpeg(request.resource.data.jpeg) && request.resource.data.by == request.auth.uid
            && request.resource.data.at == request.time;
          allow delete: if isChildOf(fid, cid);
        }
        match /voice/latest {
          allow get: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isChildOf(fid, cid) && request.resource.data.keys().hasOnly(['audio', 'by', 'at'])
            && request.resource.data.audio is string && request.resource.data.audio.size() <= 240000
            && request.resource.data.audio.matches('[A-Za-z0-9+/]+={0,2}')
            && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
          allow delete: if isChildOf(fid, cid);
        }
        match /photos/latest {
          allow get: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isChildOf(fid, cid) && request.resource.data.keys().hasOnly(['jpeg','by','at'])
            && request.resource.data.jpeg is string && request.resource.data.jpeg.size() <= 120000
            && request.resource.data.jpeg.matches('/9j/[A-Za-z0-9+/=]+')
            && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
          allow delete: if isChildOf(fid, cid);
        }
        match /settings/power {
          allow get: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isParent(fid) && childExists(fid, cid) && request.resource.data.keys().hasOnly(['percent'])
            && request.resource.data.percent in [0, 10, 20, 30, 50];
          allow delete: if isParent(fid);
        }
        match /management/{report} {
          allow get: if report == 'latest' && (isParent(fid) || isChildOf(fid, cid));
          allow create, update: if report == 'latest' && isChildOf(fid, cid)
            && request.resource.data.keys().hasOnly(['by', 'message', 'receivedAt'])
            && nonEmptyText(request.resource.data.message, 240)
            && request.resource.data.by == request.auth.uid && request.resource.data.receivedAt == request.time;
        }
        match /usage/{report} {
          allow get: if report == 'latest' && (isParent(fid) || isChildOf(fid, cid));
          allow create, update: if report == 'latest' && isChildOf(fid, cid)
            && request.resource.data.keys().hasOnly(['apps', 'measuredAt', 'screenMs', 'by', 'receivedAt', 'days'])
            && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 7))
            && request.resource.data.apps is list && request.resource.data.apps.size() <= 1000
            && (!('screenMs' in request.resource.data) || (request.resource.data.screenMs is int && request.resource.data.screenMs >= 0 && request.resource.data.screenMs <= 93600000))
            && request.resource.data.measuredAt is int && request.resource.data.measuredAt > 0
            && request.resource.data.by == request.auth.uid && request.resource.data.receivedAt == request.time;
          allow delete: if report == 'latest' && isChildOf(fid, cid);
        }

        function validLocationFields() {
          return request.resource.data.keys().hasAll(['latitude', 'longitude', 'accuracyM', 'capturedAt', 'by'])
            && request.resource.data.latitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
            && request.resource.data.accuracyM is number
            && request.resource.data.accuracyM >= 0
            && request.resource.data.accuracyM <= 100000
            && (!('measuredAt' in request.resource.data) ||
                (request.resource.data.measuredAt is int
                 && request.resource.data.measuredAt > 0
                 && request.resource.data.measuredAt <= request.time.toMillis() + 60000))
            && request.resource.data.capturedAt == request.time
            && request.resource.data.by == request.auth.uid;
        }
        function validLocation() {
          return request.resource.data.keys().hasOnly(['latitude','longitude','accuracyM','capturedAt','by','measuredAt'])
            && validLocationFields();
        }
        match /tripPoints/{slot} {
          allow read: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isChildOf(fid, cid) && slot.matches('^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-3][0-9])$')
            && request.resource.data.keys().hasOnly(['latitude','longitude','accuracyM','capturedAt','by','measuredAt','session'])
            && request.resource.data.measuredAt is int && idOk(request.resource.data.session) && validLocationFields();
          allow delete: if isChildOf(fid, cid);
        }

        match /location/{docId} {
          allow get: if docId == 'latest' && (isParent(fid) || isChildOf(fid, cid));
          allow create, update: if docId == 'latest' && isChildOf(fid, cid) && validLocation();
          allow delete: if isChildOf(fid, cid);
        }
        match /checkins/{slot} {
          allow read: if isParent(fid) || isChildOf(fid, cid);
          allow create, update: if isChildOf(fid, cid) && slot.matches('^([0-9]|1[0-9]|2[0-3])$')
            && validLocation() && 'measuredAt' in request.resource.data;
          allow delete: if isChildOf(fid, cid);
        }

        // Requests: the child asks, a parent answers once.
        match /requests/{rid} {
          allow read: if isParent(fid) || isChildOf(fid, cid);

          allow create: if isChildOf(fid, cid)
            && idOk(rid)
            && request.resource.data.keys().hasOnly(['kind', 'label', 'detail', 'minutes', 'appId', 'status', 'at', 'by'])
            && request.resource.data.keys().hasAll(['kind', 'label', 'detail', 'status', 'at', 'by'])
            && request.resource.data.kind in ['extra_time', 'unlock_app', 'install_app', 'bedtime']
            && nonEmptyText(request.resource.data.label, 80)
            && text(request.resource.data.detail, 200)
            && (!('minutes' in request.resource.data)
                  || (request.resource.data.minutes is int && request.resource.data.minutes > 0 && request.resource.data.minutes <= 240))
            && (!('appId' in request.resource.data) || nonEmptyText(request.resource.data.appId, 40))
            && request.resource.data.status == 'pending'
            && request.resource.data.at == request.time
            && request.resource.data.by == request.auth.uid;

          allow update: if isParent(fid)
            && resource.data.status == 'pending'
            && onlyChanged(['status', 'resolvedBy', 'resolvedAt'])
            && request.resource.data.status in ['approved', 'denied']
            && request.resource.data.resolvedBy == request.auth.uid
            && request.resource.data.resolvedAt == request.time;

          allow delete: if isParent(fid);
        }

        // Chat. A message is written once, as yourself, and never edited or removed.
        match /messages/{mid} {
          allow read: if isParent(fid) || isChildOf(fid, cid);

          allow create: if idOk(mid)
            && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'by'])
            && request.resource.data.keys().hasAll(['from', 'text', 'at', 'by'])
            && nonEmptyText(request.resource.data.text, 2000)
            && request.resource.data.at == request.time
            && request.resource.data.by == request.auth.uid
            && ((request.resource.data.from == 'parent' && isParent(fid) && childExists(fid, cid))
                 || (request.resource.data.from == 'child' && isChildOf(fid, cid)));

          allow update, delete: if false;
        }
      }

      // ---- alerts/{id}: the parents' activity feed --------------------------------------------
      // A child device adds entries about itself (check-in, SOS, a request, leaving the family)
      // but cannot read the feed. Parents read it and mark entries as read.

      function alertShapeOk(data) {
        return data.keys().hasOnly(['kind', 'childId', 'icon', 'color', 'title', 'body', 'unread', 'at', 'by'])
          && data.keys().hasAll(['kind', 'childId', 'icon', 'color', 'title', 'body', 'unread', 'at', 'by'])
          && nonEmptyText(data.kind, 20)
          && (data.childId == null || (data.childId is string && idOk(data.childId)))
          && text(data.icon, 40)
          && data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')
          && nonEmptyText(data.title, 120)
          && text(data.body, 240)
          && data.unread is bool;
      }

      match /alerts/{aid} {
        allow read: if isParent(fid);

        allow create: if idOk(aid)
          && alertShapeOk(request.resource.data)
          && (request.resource.data.childId == null || !exists(profilePath(fid, request.resource.data.childId)) || childExists(fid, request.resource.data.childId))
          && request.resource.data.unread == true
          && request.resource.data.at == request.time
          && request.resource.data.by == request.auth.uid
          && (isParent(fid)
               || (isChild(fid)
                    && request.resource.data.childId == myRecord(fid).childId
                    && request.resource.data.kind in ['checkin', 'sos', 'request', 'left']));

        allow update: if isParent(fid)
          && onlyChanged(['unread'])
          && request.resource.data.unread == false;

        allow delete: if isParent(fid);
      }

      // ---- Family rules: places, schedules, sites. Parent-owned, readable by the family. ------

      match /places/{id} {
        allow read: if isMember(fid);
        allow create, update: if isParent(fid) && idOk(id)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'radius', 'arrive', 'leave', 'ord', 'latitude', 'longitude'])
          && ((!('latitude' in request.resource.data) && !('longitude' in request.resource.data)) ||
            (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 &&
             request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180))
          && request.resource.data.keys().hasAll(['name', 'icon', 'radius', 'arrive', 'leave', 'ord'])
          && nonEmptyText(request.resource.data.name, 60)
          && text(request.resource.data.icon, 40)
          && request.resource.data.radius is number && request.resource.data.radius > 0 && request.resource.data.radius <= 100000
          && request.resource.data.arrive is bool
          && request.resource.data.leave is bool
          && request.resource.data.ord is number;
        allow delete: if isParent(fid);
      }

      match /schedules/{id} {
        allow read: if isMember(fid);
        allow create, update: if isParent(fid) && idOk(id)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'color', 'start', 'end', 'days', 'on', 'ord'])
          && request.resource.data.keys().hasAll(['name', 'icon', 'color', 'start', 'end', 'days', 'on', 'ord'])
          && nonEmptyText(request.resource.data.name, 60)
          && text(request.resource.data.icon, 40)
          && request.resource.data.color is string && request.resource.data.color.matches('^#[0-9A-Fa-f]{6}$')
          && nonEmptyText(request.resource.data.start, 12)
          && nonEmptyText(request.resource.data.end, 12)
          && request.resource.data.days is list && request.resource.data.days.size() == 7
          && request.resource.data.on is bool
          && request.resource.data.ord is number;
        allow delete: if isParent(fid);
      }

      match /webPolicy/adultSites {
        allow get: if isMember(fid);
        allow create, update: if isParent(fid) && request.resource.data.keys().hasOnly(['enabled'])
          && request.resource.data.enabled is bool;
        allow delete: if isParent(fid);
      }
      match /webPolicy/chrome {
        allow get: if isMember(fid);
        allow create, update: if isParent(fid)
          && request.resource.data.keys().hasOnly(['safeSearch'])
          && request.resource.data.safeSearch is bool;
        allow delete: if isParent(fid);
      }

      match /sites/{id} {
        allow read: if isMember(fid);
        allow create, update: if isParent(fid) && idOk(id)
          && request.resource.data.keys().hasOnly(['host', 'list', 'ord'])
          && request.resource.data.keys().hasAll(['host', 'list', 'ord'])
          && nonEmptyText(request.resource.data.host, 253)
          && request.resource.data.list in ['blocked', 'allowed']
          && request.resource.data.ord is number;
        allow delete: if isParent(fid);
      }

      // ---- tasks/{id}: a parent defines them, a child may only tick them ----------------------

      match /tasks/{id} {
        allow read: if isMember(fid);
        allow create, update: if isParent(fid) && idOk(id)
          && request.resource.data.keys().hasOnly(['title', 'points', 'done', 'ord'])
          && request.resource.data.keys().hasAll(['title', 'points', 'done', 'ord'])
          && nonEmptyText(request.resource.data.title, 80)
          && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= 1000
          && request.resource.data.done is bool
          && request.resource.data.ord is number;
        allow update: if isChild(fid)
          && onlyChanged(['done'])
          && request.resource.data.done is bool;
        allow delete: if isParent(fid);
      }

      // ---- signals/sos: the SOS flag -----------------------------------------------------------
      // A child raises it for itself and may clear its own. A parent may only clear it.

      match /signals/{signal} {
        allow read: if isMember(fid);

        allow create, update: if signal == 'sos'
          && request.resource.data.keys().hasOnly(['active', 'childId', 'by', 'at'])
          && request.resource.data.keys().hasAll(['active', 'childId', 'by', 'at'])
          && request.resource.data.active is bool
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && ((isParent(fid)
                 && request.resource.data.active == false
                 && (resource == null ? request.resource.data.childId == null : request.resource.data.childId == resource.data.childId))
               || (isChild(fid)
                    && request.resource.data.childId == myRecord(fid).childId
                    && (request.resource.data.active == true
                          || resource == null
                          || resource.data.active == false
                          || resource.data.childId == myRecord(fid).childId)));

        allow delete: if signal == 'sos' && isParent(fid) && resource.data.childId is string
          && retired(fid, resource.data.childId);
      }
    }

    // Everything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
