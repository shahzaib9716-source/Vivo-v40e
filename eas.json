{
  "cli": {
    "version": ">= 19.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    },
    "parent-apk": {
      "extends": "preview",
      "env": {
        "HAVEN_ANDROID_SIDE": "parent"
      }
    },
    "child-apk": {
      "extends": "preview",
      "env": {
        "HAVEN_ANDROID_SIDE": "child"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
