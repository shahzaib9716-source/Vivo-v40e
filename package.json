  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-build-properties": "58.0.12",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "^58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "firebase": "13.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:rules": "node --test --test-concurrency=1 --test-timeout=60000 tests/rules/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:sync": "node --import ./tests/sync/register.mjs --test tests/sync/unit.test.mjs tests/sync/model.test.mjs",
    "apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease && echo 'OK: the APK is at android/app/build/outputs/apk/release/app-release.apk'",
    "test:live": "node --test --test-concurrency=1 --test-timeout=400000 tests/sync/live/*.test.mjs"
  },
  "private": true
}
